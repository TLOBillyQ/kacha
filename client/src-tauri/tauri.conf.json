{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UGC AI 生图工具",
  "mainBinaryName": "ugc-image-tool",
  "identifier": "local.ugc.image-tool.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UGC AI 生图工具",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*.png",
            "**/*.jpg",
            "**/*.jpeg",
            "**/*.webp",
            "**/*.bmp",
            "**/*.gif",
            "**/*.tif",
            "**/*.tiff",
            "**/*.heic",
            "**/*.heif",
            "**/*.PNG",
            "**/*.JPG",
            "**/*.JPEG",
            "**/*.WEBP",
            "**/*.BMP",
            "**/*.GIF",
            "**/*.TIF",
            "**/*.TIFF",
            "**/*.HEIC",
            "**/*.HEIF"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ugcboard.json"
        ],
        "name": "UGC 画板",
        "description": "UGC AI 生图工具画板",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "category": "GraphicsAndDesign"
  }
}
