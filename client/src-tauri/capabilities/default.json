{
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "http://*:*" }, { "url": "https://*" }, { "url": "https://*:*" }]
    }
  ]
}
